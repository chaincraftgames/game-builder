                  "count": {
                    "min": 0,
                    "max": 2
                  }
                },
                "hooks": {
                  "onEnter": [
                    {
                      "effectRef": "turnEnergyCapUp"
                    },
                    {
                      "effectRef": "turnEnergyRefill"
                    }
                  ],
                  "onComplete": [
                    {
                      "effectRef": "thawAll"
                    }
                  ]
                }
              }
            ]
          }
        ],
        "winConditions": [
          {
            "rule": "ranking",
            "property": "player.property.life",
            "order": "highest",
            "tiebreak": "all-win"
          }
        ]
      }
    },

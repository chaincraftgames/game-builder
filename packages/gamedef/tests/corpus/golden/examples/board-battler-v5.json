    "inventories": {
      "types": [
        {
          "id": "library",
          "label": "Library",
          "scope": {
            "kind": "game"
          },
          "accepts": [
            "creature",
            "spell"
          ],
          "visibility": "never",
          "countVisibility": "always",
          "structure": "stack",
          "description": "Shared staging pile, shuffled at setup and emptied into the two sides."
        },
        {
          "id": "deck",
          "label": "Deck",
          "scope": {
            "kind": "player"
          },
          "accepts": [
            "creature",
            "spell"
          ],
          "visibility": "never",
          "countVisibility": "always",
          "structure": "stack"
        },
        {
          "id": "hand",
          "label": "Hand",
          "scope": {
            "kind": "player"
          },
          "accepts": [
            "creature",
            "spell"
          ],
          "visibility": "owner",
          "structure": "none",
          "capacity": {
            "max": 8
          }
        },
        {
          "id": "field",
          "label": "Field",
          "scope": {
            "kind": "player"
          },
          "accepts": [
            "creature"
          ],
          "visibility": "always",
          "structure": "none",
          "description": "Where creatures stand. They persist here across rounds."
        },
        {
          "id": "discard",
          "label": "Discard",
          "scope": {
            "kind": "game"
          },
          "accepts": [
            "creature",
            "spell"
          ],
          "visibility": "always",
          "structure": "none"
        }
      ]
    },
    "state": {
      "player": {
        "properties": [
          {
            "id": "life",
            "type": {
              "kind": "number",
              "min": 0,
              "max": 30
            },
            "default": 30,
            "description": "Reaching 0 does not end the match early (FG-003: win conditions only evaluate once the whole rounds loop completes)."
          },
          {
            "id": "energyCap",
            "type": {
              "kind": "number",
              "min": 0,
              "max": 6
            },
            "default": 1,
            "description": "Permanent ramp ceiling, shared schedule for both players. +1 at the start of each round, clamped at 6 (the new set's highest card cost) by this property's own declared max."
          },
          {
            "id": "energy",
            "type": {
              "kind": "number",
              "min": 0,
              "max": 6
            },
            "default": 2,
            "description": "Spendable resource. Refilled to energyCap at the start of each round; spent when a creature or spell is played."
          }
        ]
      }
    },
    "effects": {
      "effects": [
        {
          "effect": "move",
          "from": {
            "inventory": "game:unassigned",
            "select": "all"
          },
          "to": {
            "inventory": "library"
          },
          "id": "fillLibrary"
        },
        {
          "effect": "shuffle",
          "inventory": "library",
          "id": "shuffleLibrary"
        },
        {
          "effect": "distribute",
          "from": {
            "inventory": "library",
            "select": "top"
          },
          "to": {
            "inventory": "hand"
          },
          "count": 4,
          "style": "round-robin",
          "id": "dealHands"
        },
        {
          "effect": "distribute",
          "from": {
            "inventory": "library",
            "select": "top"
          },
          "to": {
            "inventory": "deck"
          },
          "count": 16,
          "style": "round-robin",
          "id": "dealDecks"
        },
        {
          "effect": "message",
          "to": "all",
          "template": "Both sides start at 30 life with 4 cards in hand and 16 in the deck. Energy ramps by 1 each round. Play creatures, cast spells, attack, and bring the other side down.",
          "id": "announceStart"
        },
        {
          "effect": "set-state",
          "path": "player.property.energyCap",
          "value": {
            "delta": 1
          },
          "target": "all",
          "id": "turnEnergyCapUp"
        },
        {
          "effect": "set-state",
          "path": "player.property.energy",
          "value": {
            "var": "player.property.energyCap"
          },
          "target": "all",
          "id": "turnEnergyRefill"
        },
        {
          "effect": "update",
          "pieces": {
            "player": "all",
            "inventory": "field",
            "select": "all"
          },
          "property": "frozen",
          "value": false,
          "id": "thawAll"
        }
      ],
      "passives": [
        {
          "id": "lifesteal",
          "trigger": {
            "kind": "state-write",
            "scope": "actor",
            "path": "player.property.life",
            "direction": "decrease"
          },
          "effects": [
            {
              "effect": "set-state",
              "path": "player.property.life",
              "value": {
                "delta": 2
              }
            }
          ]
        },
        {
          "id": "thorns",
          "trigger": {
            "kind": "state-write",
            "scope": "target",
            "path": "gamepiece.property.defense",
            "direction": "decrease"
          },
          "effects": [
            {
              "effect": "set-state",
              "path": "player.property.life",
              "value": {
                "delta": -2
              }
            }
          ]
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "id": "drawCard",
          "label": "Draw a card",
          "description": "Draw the top card of your deck into your hand.",
          "preconditions": "count(actor.inventory.hand) < 8 and count(actor.inventory.deck) > 0",
          "steps": [
            {
              "effect": "move",
              "from": {
                "inventory": "deck",
                "select": "top"
              },
              "to": {
                "inventory": "hand"
              }
            }
          ]
        },
        {
          "id": "playCreature",
          "label": "Play a creature",
          "description": "Put a creature from your hand onto your field. Costs energy.",
          "preconditions": "count(actor.inventory.hand) > 0 and actor.property.energy > 0",
          "steps": [
            {
              "input": "card",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "hand",
                "ofType": "creature",
                "fromPlayer": "actor",
                "filter": "piece.property.cost <= actor.property.energy"
              },
              "label": "Choose a creature"
            },
            {
              "effect": "move",
              "from": {
                "inventory": "hand",
                "select": {
                  "id": {
                    "param": "card"
                  }
                }
              },
              "to": {
                "inventory": "field"
              }
            },
            {
              "effect": "set-state",
              "source": {
                "param": "card"
              },
              "path": "player.property.energy",
              "value": {
                "delta": {
                  "var": "source.property.cost",
                  "negate": true
                }
              }
            }
          ]
        },
        {
          "id": "attackCreature",
          "label": "Attack a creature",
          "description": "Your creature and theirs each take the other's power.",
          "preconditions": "all(players, count(player.inventory.field) > 0)",
          "steps": [
            {
              "input": "attacker",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "field",
                "ofType": "creature",
                "fromPlayer": "actor",
                "filter": "piece.property.frozen == false"
              },
              "label": "Choose your attacker"
            },
            {
              "input": "defenderOwner",
              "type": {
                "kind": "player-select",
                "excludeSelf": true
              },
              "label": "Choose whose creature to attack"
            },
            {
              "input": "defender",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "field",
                "ofType": "creature",
                "fromPlayer": {
                  "param": "defenderOwner"
                }
              },
              "label": "Choose the creature to attack"
            },
            {
              "effect": "update",
              "source": {
                "param": "attacker"
              },
              "pieces": {
                "player": {
                  "param": "defenderOwner"
                },
                "inventory": "field",
                "select": {
                  "id": {
                    "param": "defender"
                  }
                }
              },
              "property": "defense",
              "value": {
                "delta": {
                  "var": "source.property.power",
                  "negate": true
                }
              }
            },
            {
              "effect": "update",
              "source": {
                "param": "defender"
              },
              "pieces": {
                "inventory": "field",
                "select": {
                  "id": {
                    "param": "attacker"
                  }
                }
              },
              "property": "defense",
              "value": {
                "delta": {
                  "var": "source.property.power",
                  "negate": true
                }
              }
            },
            {
              "effect": "move",
              "from": {
                "player": {
                  "param": "defenderOwner"
                },
                "inventory": "field",
                "select": "all",
                "ofType": "creature",
                "filter": "piece.property.defense <= 0"
              },
              "to": {
                "inventory": "discard"
              }
            },
            {
              "effect": "move",
              "from": {
                "inventory": "field",
                "select": "all",
                "ofType": "creature",
                "filter": "piece.property.defense <= 0"
              },
              "to": {
                "inventory": "discard"
              }
            }
          ]
        },
        {
          "id": "attackPlayer",
          "label": "Attack the opposing player",
          "description": "Your creature strikes the other player directly.",
          "preconditions": "count(actor.inventory.field) > 0",
          "steps": [
            {
              "input": "attacker",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "field",
                "ofType": "creature",
                "fromPlayer": "actor",
                "filter": "piece.property.frozen == false"
              },
              "label": "Choose your attacker"
            },
            {
              "effect": "set-state",
              "source": {
                "param": "attacker"
              },
              "path": "player.property.life",
              "value": {
                "delta": {
                  "var": "source.property.power",
                  "negate": true
                }
              },
              "target": "all-other"
            }
          ]
        },
        {
          "id": "castFreeze",
          "label": "Cast a freeze",
          "description": "Freeze one of the opposing player's creatures. Costs energy.",
          "preconditions": "count(actor.inventory.hand) > 0 and actor.property.energy > 0 and any(players, count(player.inventory.field) > 0)",
          "steps": [
            {
              "input": "card",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "hand",
                "ofType": "spell",
                "fromPlayer": "actor",
                "filter": "piece.property.cost <= actor.property.energy"
              },
              "label": "Choose a freeze card"
            },
            {
              "input": "victimOwner",
              "type": {
                "kind": "player-select",
                "excludeSelf": true
              },
              "label": "Choose whose creature to freeze"
            },
            {
              "input": "victim",
              "type": {
                "kind": "gamepiece-select",
                "inventory": "field",
                "ofType": "creature",
                "fromPlayer": {
                  "param": "victimOwner"
                }
              },
              "label": "Choose the creature to freeze"
            },
            {
              "effect": "move",
              "from": {
                "inventory": "hand",
                "select": {
                  "id": {
                    "param": "card"
                  }
                }
              },
              "to": {
                "inventory": "discard"
              }
            },
            {
              "effect": "update",
              "pieces": {
                "player": {
                  "param": "victimOwner"
                },
                "inventory": "field",
                "select": {
                  "id": {
                    "param": "victim"
                  }
                }
              },
              "property": "frozen",
              "value": true
            },
            {
              "effect": "set-state",
              "source": {
                "param": "card"
              },
              "path": "player.property.energy",
              "value": {
                "delta": {
                  "var": "source.property.cost",
                  "negate": true
                }
              }
            }
          ]
        }
      ]
    },

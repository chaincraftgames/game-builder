{
  "name": "@chaincraft/compiler",
  "version": "0.1.0",
  "description": "ChainCraft compiler — expression compiler + spec assembler (YAML → CompiledGameModule)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "imports": {
    "#compiler/*": "./dist/*"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "prebuild": "npm run clean",
    "build": "tsc --build tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@chaincraft/gamedef": "file:../gamedef",
    "@chaincraft/runtime": "file:../chaincraft-runtime",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.7",
    "jest": "^29.7.0",
    "js-yaml": "^4.2.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  }
}
